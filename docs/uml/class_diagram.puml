@startuml

enum PlayerColor {
  Red
  Blue
  Green
  None
}

enum PieceType {
  King
  Queen
  Rook
  Bishop
  Knight
  Pawn
  None
}

class Board {
  - m_squares : vector<Square>
  + Board(squareCount : int = 96)
  + getSquare(id : int) : Square*
  + getSquareCount() : int
}

class Square {
  - m_id : int
  - m_piece : Piece*
  + Square(id : int = -1)
  + getId() : int
  + isOccupied() : bool
  + getPiece() : Piece*
  + setPiece(piece : Piece*)
  + removePiece()
}

class Player {
  - m_name : string
  - m_color : PlayerColor
  - m_pieces : vector<Piece*>
  + Player(name : string, color : PlayerColor)
  + getName() : string
  + getColor() : PlayerColor
  + addPiece(piece : Piece*)
}

class Piece {
  - m_type : PieceType
  - m_owner : Player*
  - m_square : Square*
  + Piece(type : PieceType, owner : Player*, square : Square*)
  + getType() : PieceType
  + getOwner() : Player*
  + getSquare() : Square*
  + setSquare(square : Square*)
}

Board *-- Square
Square --> Piece
Player --> Piece
Piece --> Player
Piece --> Square

@enduml